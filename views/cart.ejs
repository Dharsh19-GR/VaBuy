<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>VaBuy | My Cart</title>
        <style>
            body {
                margin: 0;
                font-family: Arial, sans-serif;
                background: #f7f8fa;
                color: #20252b;
            }
            header {
                padding: 18px 6%;
                background: #fff;
                border-bottom: 1px solid #e5e7eb;
            }
            header a {
                color: #2563eb;
                text-decoration: none;
                font-size: 24px;
                font-weight: bold;
            }
            .content {
                max-width: 980px;
                margin: 34px auto;
                padding: 0 20px;
            }
            .layout {
                display: grid;
                grid-template-columns: 1fr 300px;
                gap: 24px;
            }
            .items, .summary {
                background: #fff;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                padding: 22px;
            }
            .item {
                display: flex;
                justify-content: space-between;
                gap: 20px;
                padding: 18px 0;
                border-bottom: 1px solid #e5e7eb;
            }
            .item:last-child {
                border: 0;
            }
            .price {
                font-weight: bold;
            }
            .summary p {
                display: flex;
                justify-content: space-between;
            }
            .total {
                font-size: 20px;
                font-weight: bold;
            }
            .button {
                display: block;
                padding: 12px;
                text-align: center;
                background: #2563eb;
                color: #fff;
                text-decoration: none;
                border-radius: 6px;
            }
            .error { padding: 12px; border-radius: 6px; background: #fef3f2; color: #b42318; }
            .item img { width: 90px; height: 90px; object-fit: cover; border-radius: 6px; }
        </style>
        <link rel="stylesheet" href="/styles.css">
        <script defer src="/app.js"></script>
    </head>
    <body>
        <header>
            <a href="/">VaBuy</a>
        </header>
        <main class="content">
            <h1>My Cart (<%= cartCount %>)</h1>
            <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
            <% if (!cartItems.length) { %>
                <section class="items">
                    <p>Your cart is empty.</p>
                    <a class="button" href="/">Continue shopping</a>
                </section>
            <% } else { %>
                <div class="layout">
                    <section class="items">
                        <% cartItems.forEach(item => { %>
                            <article class="item">
                                <img src="<%= item.image %>" alt="<%= item.name %>" />
                                <div>
                                    <h3><%= item.name %></h3>
                                    <p>
                                      ₹<%= item.price.toFixed(2) %> each
                                      <% if (item.offerDiscount > 0) { %>
                                        <del style="color:#667085;">₹<%= item.basePrice.toFixed(2) %></del>
                                        <span style="color:#027a48;"><%= item.offerName %> applied (−₹<%= item.offerDiscount.toFixed(2) %> each)</span>
                                      <% } %>
                                      <% if (item.couponDiscountPercent > 0) { %>
                                        <del style="color:#667085;">₹<%= item.offerPrice.toFixed(2) %></del>
                                        <span style="color:#027a48;"><%= item.couponCode %> applied (<%= item.couponDiscountPercent %>% off)</span>
                                      <% } %>
                                    </p>
                                    <form action="/cart/update/<%= item.id %>" method="post">
                                        <label for="quantity-<%= item.id %>">Quantity</label>
                                        <input id="quantity-<%= item.id %>" name="quantity" type="number" min="1" max="<%= Math.min(item.stock, item.maxPerOrder) %>" value="<%= item.quantity %>" required>
                                        <small><%= item.stock %> stock left; max <%= item.maxPerOrder %> per order</small>
                                        <button type="submit">Update</button>
                                    </form>
                                    <form action="/cart/remove/<%= item.id %>" method="post">
                                        <button type="submit" class="secondary">Remove</button>
                                    </form>
                                </div>
                                <p class="price">₹<%= (item.price * item.quantity).toFixed(2) %></p>
                            </article>
                        <% }); %>
                        <a href="/">Continue shopping</a>
                    </section>
                    <aside class="summary">
                        <h2>Order summary</h2>
                        <form action="/cart/coupon" method="post">
                            <label for="couponCode">Coupon code</label>
                            <input id="couponCode" name="code" value="<%= appliedCouponCode %>" maxlength="30" <%= appliedCouponCode ? 'readonly' : '' %> placeholder="Enter a product coupon">
                            <% if (appliedCouponCode) { %>
                                <button type="submit" formaction="/cart/coupon/remove" formmethod="post">Remove coupon</button>
                            <% } else { %>
                                <button type="submit">Apply coupon</button>
                            <% } %>
                        </form>
                        <% if (referralDiscount > 0) { %><p><span>Referral offer (<%= referralCode %>)</span><span>−₹<%= referralDiscount.toFixed(2) %></span></p><% } %>
                        <% if (offerDiscount > 0) { %><p><span>Product/category offers</span><span>−₹<%= offerDiscount.toFixed(2) %></span></p><% } %>
                        <% if (couponDiscount > 0) { %><p><span>Coupons</span><span>−₹<%= couponDiscount.toFixed(2) %></span></p><% } %>
                        <p><span>Subtotal</span><span>₹<%= subtotal.toFixed(2) %></span></p>
                        <p><span>Shipping</span><span>₹<%= shipping.toFixed(2) %></span></p>
                        <p class="total"><span>Total</span><span>₹<%= (subtotal + shipping).toFixed(2) %></span></p>
                        <a class="button" href="/checkout">Proceed to checkout</a>
                    </aside>
                </div>
            <% } %>
        </main>
    </body>
</html>
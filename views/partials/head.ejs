<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Northstar is a considered collection of useful, beautiful objects."
    />
    <title><%= title %> | Northstar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body data-page="<%= currentPath %>">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="announcement">
      <span>Northstar / Objects for a slower life</span
      ><a href="/shop">Free delivery over $150</a>
    </div>
    <header class="site-header">
      <a class="wordmark" href="/">NORTH<span>·</span>STAR</a>
      <nav class="main-nav" aria-label="Main navigation">
        <a
          class="<%= currentPath === '/' || currentPath === '/home' ? 'active' : '' %>"
          href="/"
          >Home</a
        >
        <a class="<%= currentPath === '/shop' ? 'active' : '' %>" href="/shop"
          >Collection</a
        >
        <a href="/#about">Journal</a>
      </nav>
      <nav class="utility-nav" aria-label="Utility navigation">
        <a class="icon-link" href="/login" aria-label="Account"
          >◎ <span>Account</span></a
        >
        <a class="icon-link" href="/cart" aria-label="Shopping bag"
          >Bag <b>2</b></a
        >
      </nav>
    </header>
    <main id="main-content"></main>
  </body>
</html>

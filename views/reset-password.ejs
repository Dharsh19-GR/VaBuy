<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VaBuy | Choose a new password</title>
    <style>.error{padding:12px;border-radius:6px;background:#fef3f2;color:#b42318}</style>
    <script defer src="/app.js"></script>
</head>
  <body>
    <main>
      <h1>Choose a new password</h1>
      <% if (typeof error !== "undefined" && error) { %><p class="error" role="alert"><%= error %></p><% } %>
      <form action="/reset-password" method="post">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required />
        <label for="confirmPassword">Confirm new password</label>
        <input id="confirmPassword" name="confirmPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required />
        <button type="submit">Update password</button>
      </form>
    </main>
  </body>
</html>

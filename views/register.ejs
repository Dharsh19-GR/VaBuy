<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VaBuy | Register</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #f7f9fc, #eef3fb);
        color: #20252b;
      }
      .panel {
        max-width: 480px;
        margin: 6vh auto;
        padding: 32px;
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e8edf4;
        box-shadow: 0 12px 34px #1d293910;
      }
      h1 {
        margin-top: 0;
        color: #2563eb;
      }
      label {
        display: block;
        margin: 16px 0 6px;
        font-weight: bold;
      }
      input {
        box-sizing: border-box;
        width: 100%;
        padding: 12px;
        border: 1px solid #d5dbe3;
        border-radius: 6px;
        transition: border-color .18s ease, box-shadow .18s ease;
      }
      input:focus {
        outline: none;
        border-color: #7aa5f8;
        box-shadow: 0 0 0 3px #2563eb1a;
      }
      button {
        width: 100%;
        margin-top: 24px;
        padding: 13px;
        border: 0;
        border-radius: 6px;
        background: #2563eb;
        color: white;
        font-weight: bold;
        cursor: pointer;
        transition: background .18s ease, transform .18s ease;
      }
      button:hover {
        background: #1d4ed8;
        transform: translateY(-1px);
      }
      a {
        color: #2563eb;
      }
      .muted {
        color: #667085;
        text-align: center;
      }
      .error {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px;
        border-radius: 6px;
        background: #fef3f2;
        color: #b42318;
      }
      .error[hidden] { display: none; }
      .alert-icon { width: 18px; height: 18px; flex: 0 0 18px; }
      .social {
        display: flex;
        box-sizing: border-box;
        width: 100%;
        margin-top: 14px;
        padding: 13px;
        border: 1px solid #d0d5dd;
        border-radius: 6px;
        color: #20252b;
        font-weight: bold;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        transition: border-color .18s ease, background .18s ease;
      }
      .social-logo { width: 20px; height: 20px; flex: 0 0 20px; }
      .social:hover { border-color: #98a2b3; background: #f9fafb; }
      @media (max-width: 560px) {
        .panel { margin: 20px 12px; padding: 24px 20px; }
      }
    </style>
    <script defer src="/app.js"></script>
</head>
  <body>
    <main class="panel">
      <h1>Create your account</h1>
      <p>Join VaBuy and manage your orders, wishlist, and profile.</p>
      <p class="error" role="alert" <%= typeof error !== "undefined" && error ? '' : 'hidden' %>>
        <svg class="alert-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 2.8 19a1.5 1.5 0 0 0 1.3 2.2h15.8a1.5 1.5 0 0 0 1.3-2.2L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 9v5m0 3h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="error-message"><%= typeof error !== "undefined" && error ? error : '' %></span>
      </p>
      <form action="/register" method="post" novalidate>
        <label for="name">Full name</label>
        <input
          id="name"
          name="name"
          type="text"
          placeholder="Dharshini G R"
          autocomplete="name"
          minlength="2"
          maxlength="80"
          required
        />
        <label for="email">Email address</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="dharsh@example.com"
          autocomplete="email"
          required
        />
        <label for="password">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          placeholder="At least 8 characters"
          minlength="8"
          maxlength="128"
          autocomplete="new-password"
          required
        />
        <label for="confirmPassword">Confirm password</label>
        <input
          id="confirmPassword"
          name="confirmPassword"
          type="password"
          minlength="8"
          maxlength="128"
          autocomplete="new-password"
          required
        />
        <label for="referralCode">Referral code (optional)</label>
        <input id="referralCode" name="referralCode" type="text" maxlength="30" autocomplete="off" />
        <button type="submit">Register</button>
      </form>
      <p class="muted">or sign up with</p>
      <a class="social" href="/auth/google">
        <svg class="social-logo" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5Z" transform="translate(0 4)" />
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.4-4.55H24v9.02h12.9c-.58 2.96-2.26 5.47-4.76 7.16l7.73 6C44.38 37.96 46.98 31.86 46.98 24.55Z" />
          <path fill="#FBBC05" d="M10.53 28.59a14.4 14.4 0 0 1 0-9.18l-7.98-6.19a23.9 23.9 0 0 0 0 21.56l7.98-6.19Z" transform="translate(0 4)" />
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.9-5.82l-7.73-6c-2.15 1.45-4.9 2.3-8.17 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48Z" />
        </svg>
        <span>Continue with Google</span>
      </a>
      <a class="social" href="/auth/facebook">
        <svg class="social-logo" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#1877F2" d="M24 12a12 12 0 1 0-13.875 11.85v-8.38H7.078V12h3.047V9.356c0-3.007 1.792-4.669 4.533-4.669 1.313 0 2.686.235 2.686.235v2.953h-1.513c-1.49 0-1.956.925-1.956 1.874V12h3.328l-.532 3.47h-2.796v8.38A12.002 12.002 0 0 0 24 12Z" />
        </svg>
        <span>Continue with Facebook</span>
      </a>
      <p class="muted">Already registered? <a href="/login">Login here</a></p>
    </main>
    <script>
      const registerForm = document.querySelector('form[action="/register"]');
      const errorBanner = document.querySelector(".error");
      const errorMessage = errorBanner.querySelector(".error-message");
      const requiredFields = registerForm.querySelectorAll("[required]");

      function setFieldMessage(field) {
        if (field.validity.valueMissing) {
          field.setCustomValidity("Please fill all the details to create an account.");
        } else if (field.type === "email" && field.validity.typeMismatch) {
          field.setCustomValidity("Enter a valid email address.");
        } else {
          field.setCustomValidity("");
        }
      }

      requiredFields.forEach((field) => {
        setFieldMessage(field);
        field.addEventListener("input", () => { setFieldMessage(field); errorBanner.hidden = true; });
        field.addEventListener("change", () => { setFieldMessage(field); errorBanner.hidden = true; });
      });

      const password = document.getElementById("password");
      const confirmPassword = document.getElementById("confirmPassword");

      function validatePasswords() {
        confirmPassword.setCustomValidity(
          confirmPassword.value && confirmPassword.value !== password.value
            ? "Passwords do not match."
            : "",
        );
      }

      password.addEventListener("input", validatePasswords);
      confirmPassword.addEventListener("input", validatePasswords);

      registerForm.addEventListener("submit", (event) => {
        requiredFields.forEach(setFieldMessage);
        validatePasswords();
        const invalidField = [...registerForm.elements].find((field) => field.willValidate && !field.validity.valid);
        if (!invalidField) return;
        event.preventDefault();
        errorMessage.textContent = invalidField.validity.valueMissing
          ? "Please fill all the details to create an account."
          : invalidField.type === "email" && invalidField.validity.typeMismatch
            ? "Enter a valid email address."
            : invalidField.validationMessage;
        errorBanner.hidden = false;
      });
    </script>
  </body>
</html>

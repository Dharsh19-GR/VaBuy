<%- include('../partials/head') %>
<section class="product-detail">
  <div class="product-gallery">
    <div class="detail-image chair-image"></div>
    <div class="gallery-thumbs">
      <div class="thumb chair-image"></div>
      <div class="thumb lamp-image"></div>
      <div class="thumb tray-image"></div>
    </div>
  </div>
  <div class="product-info">
    <p class="eyebrow">Northstar / Seating</p>
    <h1>Form 01<br /><em>Lounge chair</em></h1>
    <p class="detail-price">$780</p>
    <p class="detail-description">
      An inviting silhouette with a quietly generous seat. Form 01 is
      upholstered in a soft oat boucle and grounded by a solid ash frame, shaped
      and finished by hand.
    </p>
    <div class="option-row">
      <span>Color</span
      ><button class="swatch swatch-oat" aria-label="Oat boucle"></button
      ><span>Oat boucle</span>
    </div>
    <div class="quantity-row">
      <span>Quantity</span>
      <div class="quantity">
        <button type="button">−</button><span>1</span
        ><button type="button">+</button>
      </div>
    </div>
    <a class="button button-dark add-button" href="/cart"
      >Add to bag <span>↗</span></a
    >
    <div class="detail-notes">
      <p><span>Details</span> 31"w × 32"d × 29"h / Made to order</p>
      <p><span>Delivery</span> Ships in 4–6 weeks / Complimentary delivery</p>
      <p><span>Care</span> Spot clean with a soft, damp cloth</p>
    </div>
  </div>
</section>
<%- include('../partials/foot') %>

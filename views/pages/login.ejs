<%- include('../partials/head') %>
<section class="auth-page">
  <div class="auth-panel">
    <p class="eyebrow">Northstar / Account</p>
    <h1>Welcome<br /><em>back.</em></h1>
    <form class="auth-form">
      <label
        >Email address<input
          type="email"
          placeholder="you@example.com" /></label
      ><label
        >Password<input type="password" placeholder="Your password" /></label
      ><a class="forgot-link" href="#about">Forgot password?</a
      ><button class="button button-dark" type="submit">
        Sign in <span>↗</span>
      </button>
    </form>
    <p class="auth-switch">
      New here? <a href="/register">Create an account</a>
    </p>
  </div>
  <div class="auth-art lamp-image">
    <span>Good things<br />take time.</span>
  </div>
</section>
<%- include('../partials/foot') %>

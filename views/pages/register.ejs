<%- include('../partials/head') %>
<section class="auth-page">
  <div class="auth-panel">
    <p class="eyebrow">Northstar / Account</p>
    <h1>Make yourself<br /><em>at home.</em></h1>
    <form class="auth-form">
      <label>Full name<input type="text" placeholder="Your name" /></label
      ><label
        >Email address<input
          type="email"
          placeholder="you@example.com" /></label
      ><label
        >Password<input
          type="password"
          placeholder="Choose a password" /></label
      ><button class="button button-dark" type="submit">
        Create account <span>↗</span>
      </button>
    </form>
    <p class="auth-switch">Already a member? <a href="/login">Sign in</a></p>
  </div>
  <div class="auth-art vase-image">
    <span>For the things<br />you keep.</span>
  </div>
</section>
<%- include('../partials/foot') %>

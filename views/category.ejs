<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VaBuy | <%= category.name %></title>
  <link rel="stylesheet" href="/styles.css">
  <script defer src="/app.js"></script>
  <style>
    body { margin:0; font-family:Arial,sans-serif; color:#20252b; background:#f7f8fa; }
    header { padding:18px 6%; display:flex; justify-content:space-between; align-items:center; gap:16px; background:#fff; border-bottom:1px solid #e5e7eb; }
    nav { display:flex; align-items:center; flex-wrap:wrap; gap:18px; } nav a { color:#344054; text-decoration:none; }
    .brand { color:#2563eb; font-size:24px; font-weight:bold; }
    main { padding:34px 6%; } .intro { margin-bottom:28px; } .intro a { color:#2563eb; }
    .products { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:20px; }
    .product { padding:20px; background:#fff; border:1px solid #e5e7eb; border-radius:8px; }
    .product-media { position:relative; } .image { width:100%; height:180px; object-fit:cover; border-radius:6px; display:block; }
    .price { font-size:20px; font-weight:bold; } .button { display:inline-block; padding:10px 14px; background:#2563eb; color:#fff; border:0; border-radius:6px; text-decoration:none; cursor:pointer; }
    .badge { display:inline-block; padding:4px 8px; margin:2px; border-radius:999px; background:#ecfdf3; color:#027a48; font-size:12px; }
    .filters { display:flex; flex-wrap:wrap; gap:10px; margin:18px 0 24px; padding:16px; border:1px solid #e5e7eb; border-radius:8px; background:#fff; }
    .filters input,.filters select { min-width:0; flex:1 1 170px; padding:10px; border:1px solid #d5dbe3; border-radius:6px; }
    @media(max-width:700px) { header { align-items:flex-start; flex-direction:column; } header nav { gap:10px; } main { padding:24px 16px; } .filters input,.filters select,.filters button { flex-basis:100%; width:100%; } }
    .sold-out { color:#b42318; font-weight:bold; }
  </style>
</head>
<body>
  <header><a class="brand" href="/">VaBuy</a><nav><a href="/">Shop all</a><a href="/cart">My Cart (<%= cartCount %>)</a><a href="/wishlist">Wishlist</a><% if (currentUser) { %><a href="/profile">Hi, <%= currentUser.name %></a><form action="/logout" method="post" style="display:inline;"><button type="submit">Sign out</button></form><% } else { %><a href="/login">Login</a><a href="/register">Sign up</a><% } %></nav></header>
  <main>
    <section class="intro"><p><a href="/">Home</a> / <%= category.name %></p><h1><%= category.name %></h1><p>Browse products in <%= category.name %>.</p><p class="store-notice" role="status" hidden></p></section>
    <form class="filters" action="/categories/<%= encodeURIComponent(category.slug) %>" method="get">
      <input type="search" name="q" value="<%= filters.q %>" placeholder="Search this category" aria-label="Search this category">
      <select name="sort" aria-label="Sort products"><option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>New arrivals</option><option value="popularity" <%= filters.sort === 'popularity' ? 'selected' : '' %>>Popularity</option><option value="price-low" <%= filters.sort === 'price-low' ? 'selected' : '' %>>Price: low to high</option><option value="price-high" <%= filters.sort === 'price-high' ? 'selected' : '' %>>Price: high to low</option><option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Top rated</option></select>
      <select name="stock" aria-label="Filter by availability"><option value="available" <%= filters.stock === 'available' ? 'selected' : '' %>>In stock</option><option value="sold-out" <%= filters.stock === 'sold-out' ? 'selected' : '' %>>Sold out</option><option value="all" <%= filters.stock === 'all' ? 'selected' : '' %>>All availability</option></select>
      <button class="button" type="submit">Apply filters</button>
    </form>
    <% if (!products.length) { %><p>No products are available in this category yet.</p><% } %>
    <div class="products">
      <% products.forEach(product => { %>
        <article class="product">
          <div class="product-media"><a href="/products/<%= product.id %>?returnTo=<%= encodeURIComponent(returnTo) %>" aria-label="View <%= product.name %>"><img class="image" src="<%= product.image %>" alt="<%= product.name %>"></a>
            <form class="wishlist-toggle-form" action="/wishlist/toggle/<%= product.id %>" method="post"><input type="hidden" name="returnTo" value="<%= returnTo %>"><button class="wishlist-toggle <%= product.isWishlisted ? 'is-active' : '' %>" type="submit" aria-label="<%= product.isWishlisted ? 'Remove ' + product.name + ' from wishlist' : 'Add ' + product.name + ' to wishlist' %>" aria-pressed="<%= product.isWishlisted %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/></svg></button></form>
          </div>
          <h2><a href="/products/<%= product.id %>?returnTo=<%= encodeURIComponent(returnTo) %>"><%= product.name %></a></h2>
          <% if (product.imageNote) { %><p class="muted"><%= product.imageNote %></p><% } %>
          <p>★ <%= Number(product.rating || 0).toFixed(1) %>/5</p>
          <% if (product.compareAtPrice > product.price || product.offerDiscount > 0 || (product.couponCode && product.couponDiscountPercent > 0)) { %><div><% if (product.compareAtPrice > product.price) { %><span class="badge">Save <%= Math.round((product.compareAtPrice - product.price) / product.compareAtPrice * 100) %>%</span><% } %><% if (product.offerDiscount > 0) { %><span class="badge"><%= product.offer.name %></span><% } %><% if (product.couponCode && product.couponDiscountPercent > 0) { %><span class="badge"><%= product.couponCode %> · Cart coupon</span><% } %></div><% } %>
          <p class="price">₹<%= Number(product.offerPrice).toFixed(2) %><% if (product.offerDiscount > 0) { %> <del style="font-size:14px;color:#667085;">₹<%= Number(product.price).toFixed(2) %></del><% } else if (product.compareAtPrice > product.price) { %> <del style="font-size:14px;color:#667085;">₹<%= Number(product.compareAtPrice).toFixed(2) %></del><% } %></p>
          <% if (product.stock > 0) { %><p class="stock"><%= product.stock %> in stock · Max <%= Math.min(99, Number(product.maxPerOrder || 5)) %> per order</p><% } else { %><p class="sold-out" role="status">Sold out</p><% } %>
        </article>
      <% }); %>
    </div>
  </main>
</body>
</html>

<%
  const reviews = Array.isArray(product.reviews) ? product.reviews : [];
  const averageReviewRating = reviews.length
    ? reviews.reduce((total, review) => total + Number(review.rating || 0), 0) / reviews.length
    : Number(product.rating || 0);
  const images = Array.isArray(product.images) && product.images.length
    ? product.images
    : [product.image || "/images/backpack-1.svg"];
%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VaBuy | <%= product.name %></title>
    <link rel="stylesheet" href="/styles.css">
    <script defer src="/app.js"></script>
    <style>
      body { margin: 0; font-family: Arial, sans-serif; background: #f7f8fa; color: #20252b; }
      .content { max-width: 1000px; margin: 34px auto; padding: 0 20px; }
      .product { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; background: #fff; padding: 26px; border: 1px solid #e5e7eb; border-radius: 8px; }
      .gallery-main { width: 100%; height: 360px; object-fit: cover; background: #eef2ff; border-radius: 6px; cursor: zoom-in; }
      .quantity-control { display: inline-flex; align-items: center; overflow: hidden; margin: 6px 0 14px; border: 1px solid #d0d5dd; border-radius: 8px; background: #fff; }
      .quantity-control button { width: 42px; height: 42px; border: 0; background: #f8fafc; color: #20252b; font-size: 22px; cursor: pointer; }
      .quantity-control button:hover:not(:disabled) { background: #eef2f6; }
      .quantity-control button:disabled { color: #98a2b3; cursor: not-allowed; }
      .quantity-control input { width: 54px; height: 42px; padding: 0; border: 0; border-right: 1px solid #eaecf0; border-left: 1px solid #eaecf0; border-radius: 0; text-align: center; font: inherit; }
      .quantity-control input:focus { outline: 2px solid #2563eb; outline-offset: -2px; }
      .thumbnails { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
      .thumbnail { width: 72px; height: 72px; padding: 0; border: 2px solid transparent; border-radius: 6px; background: transparent; cursor: pointer; }
      .thumbnail[aria-pressed="true"] { border-color: #2563eb; }
      .thumbnail img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
      .price { font-size: 28px; font-weight: bold; }
      .button { display: inline-block; padding: 12px 18px; background: #2563eb; color: #fff; border-radius: 6px; text-decoration: none; border: 0; cursor: pointer; }
      .review { padding: 14px 0; border-bottom: 1px solid #e5e7eb; }
      .badge { display:inline-block; padding:6px 10px; margin:4px 4px 4px 0; border-radius:999px; background:#ecfdf3; color:#027a48; font-size:13px; }
      .stock { color:#027a48; font-weight:bold; }
      .sold-out { color:#b42318; font-weight:bold; }
      .coupon { padding:14px; border:1px dashed #12b76a; border-radius:8px; background:#f6fef9; }
      .specifications { border-collapse:collapse; width:100%; max-width:620px; }
      .specifications th,.specifications td { padding:10px; border-bottom:1px solid #e5e7eb; text-align:left; }
      .recommendations { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:16px; }
      .related { padding:12px; background:#fff; border:1px solid #e5e7eb; border-radius:8px; color:inherit; text-decoration:none; }
      .related img { width:100%; height:150px; object-fit:cover; border-radius:6px; }
      .zoom-modal { width:min(90vw,900px); max-width:90vw; max-height:90vh; padding:12px; border:0; border-radius:10px; }
      .zoom-modal::backdrop { background:rgba(16,24,40,.82); }
      .zoom-modal img { display:block; width:100%; max-height:78vh; object-fit:contain; }
      .zoom-modal button { margin-top:10px; padding:9px 14px; }
      @media(max-width: 700px) { .product { grid-template-columns: 1fr; } .gallery-main { height: 280px; } }
    </style>
  </head>
  <body>
    <main class="content">
      <nav aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/categories/<%= encodeURIComponent(product.categorySlug) %>"><%= product.categoryName || product.category %></a> / <span aria-current="page"><%= product.name %></span> <span style="float:right;"><a href="/cart">My Cart (<%= cartCount %>)</a></span></nav>
      <p class="store-notice" role="status" hidden></p><p><a class="button secondary" href="<%= returnTo %>">Back to results</a></p>
      <section class="product">
        <div>
          <button id="zoom-trigger" type="button" style="display:block;width:100%;padding:0;border:0;background:none;" aria-label="Zoom product image">
            <img id="main-product-image" class="gallery-main" src="<%= images[0] %>" alt="<%= product.name %>" />
          </button>
          <% if (images.length > 1) { %>
            <div class="thumbnails" aria-label="Product images">
              <% images.forEach((image, index) => { %>
                <button class="thumbnail" type="button" data-image="<%= image %>" aria-label="Show product image <%= index + 1 %>" aria-pressed="<%= index === 0 %>">
                  <img src="<%= image %>" alt="" />
                </button>
              <% }); %>
            </div>
          <% } %>
          <% if (product.imageNote) { %><p class="muted"><%= product.imageNote %></p><% } %>
        </div>
        <div>
          <p><a href="/categories/<%= encodeURIComponent(product.categorySlug) %>"><%= product.categoryName || product.category %></a></p>
          <h1><%= product.name %></h1>
          <p aria-label="Rated <%= averageReviewRating.toFixed(1) %> out of 5">★ <strong><%= averageReviewRating.toFixed(1) %>/5</strong> (<%= reviews.length %> reviews)</p>
          <p class="price">₹<%= Number(offerPrice).toFixed(2) %>
            <% if (offerDiscount > 0) { %><del style="font-size:16px;color:#667085;">₹<%= Number(product.price).toFixed(2) %></del><span class="badge"><%= productOffer.name %></span><% } %>
            <% if (discountPercent > 0) { %><del style="font-size:16px;color:#667085;">₹<%= Number(product.compareAtPrice).toFixed(2) %></del><span class="badge"><%= discountPercent %>% off</span><% } %>
          </p>
          <% if (product.couponCode && couponPrice !== null) { %>
            <div class="coupon">Use coupon <strong><%= product.couponCode %></strong> in your cart to save <%= product.couponDiscountPercent %>%. Your price after offer and coupon is <strong>₹<%= couponPrice.toFixed(2) %></strong>.</div>
          <% } else if (!discountPercent) { %>
            <p class="muted">No discounts or coupon offers are currently applied to this product.</p>
          <% } %>
          <p><%= product.description %></p>
          <% if (product.stock > 0) { %>
            <p class="stock"><strong><%= product.stock %></strong> in stock · Maximum <%= Math.min(99, Number(product.maxPerOrder || 5)) %> per person per order</p>
            <form action="/cart" method="post">
              <input type="hidden" name="productId" value="<%= product.id %>" />
              <input type="hidden" name="returnTo" value="<%= returnTo %>" />
              <label for="quantity">Quantity</label>
              <div class="quantity-control" data-quantity-control>
                <button type="button" data-quantity-step="-1" aria-label="Decrease quantity">−</button>
                <input id="quantity" name="quantity" type="number" min="1" max="<%= Math.min(product.stock, product.maxPerOrder || 5, 99) %>" value="1" required />
                <button type="button" data-quantity-step="1" aria-label="Increase quantity">+</button>
              </div>
              <button class="button" type="submit">Add to cart</button>
            </form>
          <% } else { %>
            <p class="sold-out" role="status">Sold out — this product is currently out of stock.</p>
            <button class="button" type="button" disabled aria-disabled="true">Unavailable</button>
          <% } %>
          <form class="wishlist-detail-form" action="/wishlist/toggle/<%= product.id %>" method="post">
            <input type="hidden" name="returnTo" value="<%= returnTo %>">
            <button class="wishlist-toggle <%= isWishlisted ? 'is-active' : '' %>" type="submit" aria-label="<%= isWishlisted ? 'Remove from wishlist' : 'Add to wishlist' %>" aria-pressed="<%= isWishlisted %>">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/></svg>
              <span><%= isWishlisted ? 'Saved to wishlist' : 'Add to wishlist' %></span>
            </button>
          </form>
        </div>
      </section>
      <section>
        <h2>Highlights</h2>
        <% if (product.highlights && product.highlights.length) { %>
          <ul><% product.highlights.forEach(highlight => { %><li><%= highlight %></li><% }); %></ul>
        <% } else { %><p>Product highlights have not been provided yet.</p><% } %>
      </section>
      <section>
        <h2>Specifications</h2>
        <% if (product.specifications && product.specifications.length) { %>
          <table class="specifications"><tbody><% product.specifications.forEach(specification => { %><tr><th scope="row"><%= specification.name %></th><td><%= specification.value %></td></tr><% }); %></tbody></table>
        <% } else { %><p>Product specifications have not been provided yet.</p><% } %>
      </section>
      <section id="reviews">
        <h2>Customer reviews</h2>
        <% if (canReview) { %>
          <form action="/products/<%= product._id %>/reviews" method="post" class="review-form">
            <label for="review-rating">Your rating</label>
            <select id="review-rating" name="rating" required><option value="">Choose a rating</option><% [5,4,3,2,1].forEach(rating => { %><option value="<%= rating %>"><%= rating %> / 5</option><% }); %></select>
            <label for="review-title">Title</label><input id="review-title" name="title" maxlength="100" required>
            <label for="review-text">Review</label><textarea id="review-text" name="text" minlength="5" maxlength="1500" required></textarea>
            <button type="submit">Submit review</button>
          </form>
        <% } else if (hasReviewed) { %><p>You have already reviewed this product.</p><% } else if (currentUser) { %><p>Reviews are available after a paid order is delivered.</p><% } else { %><p><a href="/login">Sign in</a> after a delivered purchase to leave a review.</p><% } %>
        <% if (reviews.length) { %>
          <% reviews.forEach(review => { %>
            <article class="review">
              <strong><%= review.title || review.name || 'Customer review' %></strong>
              <p>★ <%= Number(review.rating).toFixed(1) %>/5<% if (review.name) { %> · <%= review.name %><% } %></p>
              <p><%= review.text %></p>
            </article>
          <% }); %>
        <% } else { %><p>No customer reviews yet.</p><% } %>
      </section>
      <% if (relatedProducts.length) { %>
        <section>
          <h2>Related products</h2>
          <div class="recommendations">
            <% relatedProducts.forEach(related => { %>
              <a class="related" href="/products/<%= related.id %>?returnTo=<%= encodeURIComponent(returnTo) %>">
                <img src="<%= related.image %>" alt="<%= related.name %>" />
                <h3><%= related.name %></h3>
                <p>★ <%= Number(related.rating || 0).toFixed(1) %>/5</p>
                <strong>₹<%= Number(related.price).toFixed(2) %></strong>
              </a>
            <% }); %>
          </div>
        </section>
      <% } %>
    </main>
    <dialog id="image-zoom" class="zoom-modal" aria-label="Zoomed product image">
      <img id="zoomed-product-image" src="<%= images[0] %>" alt="<%= product.name %>" />
      <button id="close-zoom" type="button">Close</button>
    </dialog>
    <script>
      const mainImage = document.getElementById("main-product-image");
      const zoomDialog = document.getElementById("image-zoom");
      const zoomImage = document.getElementById("zoomed-product-image");
      document.getElementById("zoom-trigger").addEventListener("click", () => {
        zoomImage.src = mainImage.src;
        zoomDialog.showModal();
      });
      document.getElementById("close-zoom").addEventListener("click", () => zoomDialog.close());
      document.querySelectorAll(".thumbnail").forEach((button) => {
        button.addEventListener("click", () => {
          mainImage.src = button.dataset.image;
          zoomImage.src = mainImage.src;
          document.querySelectorAll(".thumbnail").forEach((item) => {
            item.setAttribute("aria-pressed", String(item === button));
          });
        });
      });

      const quantityInput = document.getElementById("quantity");
      if (quantityInput) {
        const quantityControl = quantityInput.closest("[data-quantity-control]");
        const quantityButtons = quantityControl.querySelectorAll("[data-quantity-step]");
        const minQuantity = Number(quantityInput.min) || 1;
        const maxQuantity = Number(quantityInput.max) || 99;
        const updateQuantityButtons = () => {
          const value = Math.min(maxQuantity, Math.max(minQuantity, Number(quantityInput.value) || minQuantity));
          quantityInput.value = value;
          quantityButtons.forEach((button) => {
            const step = Number(button.dataset.quantityStep);
            button.disabled = step < 0 ? value <= minQuantity : value >= maxQuantity;
          });
        };
        quantityButtons.forEach((button) => {
          button.addEventListener("click", () => {
            quantityInput.value = Number(quantityInput.value || minQuantity) + Number(button.dataset.quantityStep);
            updateQuantityButtons();
          });
        });
        quantityInput.addEventListener("input", updateQuantityButtons);
        quantityInput.addEventListener("change", updateQuantityButtons);
        updateQuantityButtons();
      }
    </script>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VaBuy Admin | Inventory</title>
    <style>
      body{margin:0;font-family:Arial,sans-serif;background:#f4f6f8;color:#20252b}.content{max-width:1100px;margin:32px auto;padding:0 20px}.panel{padding:20px;background:#fff;border:1px solid #e5e7eb;border-radius:8px}.table{width:100%;border-collapse:collapse}.table th,.table td{text-align:left;padding:13px;border-bottom:1px solid #e5e7eb}.table input{width:100px;padding:8px;border:1px solid #d5dbe3;border-radius:5px}button{padding:9px 12px;background:#2563eb;color:#fff;border:0;border-radius:5px;cursor:pointer}.low{color:#b42318;font-weight:bold}
    </style>
  </head>
  <body>
    <main class="content">
      <p><a href="/admin">← Dashboard</a> · <a href="/admin/products">Products</a> · <a href="/admin/orders">Orders</a></p>
      <h1>Inventory management</h1>
      <section class="panel">
        <% if (!products.length) { %><p>No products to manage.</p><% } else { %>
          <table class="table">
            <thead><tr><th>Product</th><th>Max per order</th><th>Stock available</th><th>Set stock</th></tr></thead>
            <tbody>
              <% products.forEach(product => { %>
                <tr>
                  <td><%= product.name %></td>
                  <td><%= product.maxPerOrder %></td>
                  <td class="<%= product.stock <= 5 ? 'low' : '' %>"><%= product.stock %></td>
                  <td><form action="/admin/inventory/<%= product._id %>" method="post"><input aria-label="Stock for <%= product.name %>" name="stock" type="number" min="0" step="1" value="<%= product.stock %>" required><button type="submit">Save stock</button></form></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </section>
    </main>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VaBuy Admin | <%= order.orderNumber %></title>
    <style>
      body{margin:0;font-family:Arial,sans-serif;background:#f4f6f8;color:#20252b}.content{max-width:950px;margin:32px auto;padding:0 20px}.panel{padding:22px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;margin-bottom:18px}.item{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #e5e7eb}.row{display:flex;align-items:end;gap:12px}label{display:block;margin:10px 0 6px;font-weight:bold}select{padding:10px;min-width:200px}button{padding:10px 14px;background:#2563eb;color:#fff;border:0;border-radius:6px;cursor:pointer}.danger{background:#b42318}.status{text-transform:capitalize}
    </style>
  </head>
  <body>
    <main class="content">
      <p><a href="/admin/orders">← Back to orders</a></p>
      <h1>Order <%= order.orderNumber %></h1>
      <section class="panel">
        <p><strong>Customer:</strong> <%= order.customerName %> · <%= order.customerEmail %></p>
        <p><strong>Placed:</strong> <%= new Date(order.createdAt).toLocaleString() %></p>
        <p><strong>Status:</strong> <span class="status"><%= order.status %></span></p>
        <p><strong>Payment:</strong> <%= order.paymentMethod === 'cash_on_delivery' ? 'Cash on delivery' : order.paymentMethod %> (<%= order.paymentStatus %>)</p>
        <% if (order.cancellationReason) { %><p><strong>Cancellation:</strong> <%= order.cancellationReason %></p><% } %>
        <% if (order.returnReason) { %><p><strong>Return request:</strong> <%= order.returnReason %></p><% } %>
        <% if (order.walletRefundStatus === 'completed') { %><p>Wallet refund credited.</p><% } %>
        <% if (order.status === 'cancellation_requested') { %>
          <form class="row" action="/admin/orders/<%= order._id %>/status" method="post"><input type="hidden" name="status" value="cancelled"><button class="danger" type="submit">Approve cancellation and refund</button></form>
          <form class="row" action="/admin/orders/<%= order._id %>/cancellation/reject" method="post"><button type="submit">Decline cancellation request</button></form>
        <% } else if (order.status === 'return_requested') { %>
          <form class="row" action="/admin/orders/<%= order._id %>/status" method="post">
            <input type="hidden" name="status" value="returned">
            <button type="submit">Approve return and credit wallet</button>
          </form>
          <form class="row" action="/admin/orders/<%= order._id %>/return/reject" method="post"><button type="submit">Decline return request</button></form>
        <% } else if (!['cancelled', 'delivered', 'returned', 'return_requested'].includes(order.status)) { %>
          <form class="row" action="/admin/orders/<%= order._id %>/status" method="post">
            <div>
              <label for="status">Update status</label>
              <select id="status" name="status" required>
                <% const nextStatus = { pending: 'confirmed', confirmed: 'shipped', shipped: 'delivered' }[order.status]; if (nextStatus) { %>
                  <option value="<%= nextStatus %>"><%= nextStatus[0].toUpperCase() + nextStatus.slice(1) %></option>
                <% } %>
                <% if (['pending', 'confirmed'].includes(order.status)) { %>
                  <option value="cancelled">Cancelled</option>
                <% } %>
              </select>
            </div>
            <button type="submit">Update order</button>
          </form>
        <% } %>
      </section>
      <section class="panel">
        <h2>Items</h2>
        <% order.items.forEach(item => { %><div class="item"><span><%= item.name %> × <%= item.quantity %></span><strong>₹<%= (item.unitPrice * item.quantity - Number(item.referralDiscount || 0)).toFixed(2) %></strong></div><% }); %>
        <% if (order.offerDiscount > 0) { %><p>Product/category offer discount: −₹<%= order.offerDiscount.toFixed(2) %></p><% } %>
        <% if (order.couponDiscount > 0) { %><p>Coupon discount: −₹<%= order.couponDiscount.toFixed(2) %></p><% } %>
        <% if (order.referralDiscount > 0) { %><p>Referral discount (<%= order.referralCode %>): −₹<%= order.referralDiscount.toFixed(2) %></p><% } %>
        <p>Subtotal: ₹<%= order.subtotal.toFixed(2) %></p>
        <p>Shipping: ₹<%= order.shipping.toFixed(2) %> · Tax: ₹<%= order.tax.toFixed(2) %></p>
        <p><strong>Total: ₹<%= order.total.toFixed(2) %></strong></p>
      </section>
      <section class="panel">
        <h2>Delivery address</h2>
        <p><%= order.shippingAddress.recipient %> · <%= order.shippingAddress.phone %></p>
        <p><%= order.shippingAddress.line1 %><% if (order.shippingAddress.line2) { %>, <%= order.shippingAddress.line2 %><% } %></p>
        <p><%= order.shippingAddress.city %><% if (order.shippingAddress.region) { %>, <%= order.shippingAddress.region %><% } %> <%= order.shippingAddress.postalCode %>, <%= order.shippingAddress.country %></p>
      </section>
    </main>
  </body>
</html>

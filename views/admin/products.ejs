<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VaBuy Admin | Products</title>
    <style>
      body { margin: 0; font-family: Arial, sans-serif; background: #f4f6f8; color: #20252b; }
      .main { max-width: 1200px; margin: 30px auto; padding: 0 20px; }
      .top { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
      .button { display: inline-block; padding: 11px 16px; background: #2563eb; color: #fff; text-decoration: none; border-radius: 6px; }
      .panel { overflow: auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; }
      .table { width: 100%; border-collapse: collapse; }
      .table th, .table td { padding: 15px; text-align: left; border-bottom: 1px solid #e5e7eb; }
      .link { color: #2563eb; margin-right: 12px; }
      .thumb { width: 52px; height: 52px; object-fit: cover; border-radius: 6px; }
      .badge { display: inline-block; padding: 4px 8px; border-radius: 999px; font-size: 12px; background: #dcfce7; color: #166534; }
    </style>
  </head>
  <body>
    <main class="main">
      <p><a href="/admin">Admin dashboard</a></p>
      <div class="top">
        <h1>Products</h1>
        <div>
          <a class="button" href="/admin/products/new">Add product</a>
        </div>
      </div>
      <section class="panel">
        <table class="table">
          <thead>
            <tr>
              <th>Image</th>
              <th>Product</th>
              <th>Category</th>
              <th>Price (INR)</th>
              <th>Stock</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(product => { %>
              <tr>
                <td><img class="thumb" src="<%= product.images?.[0] || '/images/backpack-1.svg' %>" alt="<%= product.name %>" /></td>
                <td><%= product.name %></td>
                <td><%= product.category?.name || product.category || 'Uncategorized' %></td>
                <td>₹<%= Number(product.price || 0).toFixed(2) %></td>
                <td><%= product.stock %></td>
                <td><span class="badge"><%= product.isDeleted ? 'Deleted' : 'Active' %></span></td>
                <td>
                  <a class="link" href="/admin/products/<%= product._id %>/edit">Edit</a>
                  <form action="/admin/products/<%= product._id %>/delete" method="post" style="display:inline;" onsubmit="return confirm('Soft-delete this product?');">
                    <button class="link" type="submit" style="border:0;background:none;padding:0;font:inherit;cursor:pointer;">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </section>
    </main>
  </body>
</html>

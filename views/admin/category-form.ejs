<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VaBuy Admin | <%= isEdit ? 'Edit' : 'Add' %> category</title>
    <style>
      body { margin: 0; font-family: Arial, sans-serif; background: #f4f6f8; color: #20252b; }
      .panel { max-width: 640px; margin: 30px auto; padding: 26px; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; }
      label { display: block; margin: 15px 0 6px; font-weight: bold; }
      input { box-sizing: border-box; width: 100%; padding: 11px; border: 1px solid #d5dbe3; border-radius: 6px; }
      button { margin-top: 22px; padding: 12px 18px; border: 0; border-radius: 6px; background: #2563eb; color: #fff; font-weight: bold; cursor: pointer; }
      a { color: #2563eb; }
    </style>
  </head>
  <body>
    <main class="panel">
      <p><a href="/admin/categories">Back to categories</a></p>
      <h1><%= isEdit ? 'Edit' : 'Add' %> category</h1>
      <form action="/admin/categories" method="post">
        <% if (isEdit && category && category._id) { %>
          <input type="hidden" name="categoryId" value="<%= category._id %>" />
        <% } %>
        <label for="name">Category name</label>
        <input id="name" name="name" type="text" value="<%= category.name || '' %>" required />
        <button type="submit"><%= isEdit ? 'Update category' : 'Save category' %></button>
      </form>
    </main>
  </body>
</html>

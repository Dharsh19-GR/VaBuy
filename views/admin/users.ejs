<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VaBuy Admin | Users</title>
    <style>
      body { margin: 0; font-family: Arial, sans-serif; background: #f4f6f8; color: #20252b; }
      .main { max-width: 1100px; margin: 30px auto; padding: 0 20px; }
      .panel { overflow: auto; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; }
      .table { width: 100%; border-collapse: collapse; }
      .table th, .table td { padding: 15px; text-align: left; border-bottom: 1px solid #e5e7eb; }
      .link { color: #2563eb; }
      .badge { display: inline-block; padding: 4px 8px; border-radius: 999px; font-size: 12px; }
      .active { background: #dcfce7; color: #166534; }
      .blocked { background: #fee2e2; color: #991b1b; }
    </style>
  </head>
  <body>
    <main class="main">
      <p><a href="/admin">Admin dashboard</a></p>
      <h1>Users</h1>
      <section class="panel">
        <table class="table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Joined</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr>
                <td><%= user.name %></td>
                <td><%= user.email %></td>
                <td><%= user.role %></td>
                <td><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString() : 'N/A' %></td>
                <td>
                  <span class="badge <%= user.isBlocked ? 'blocked' : 'active' %>"><%= user.isBlocked ? 'Blocked' : 'Active' %></span>
                </td>
                <td>
                  <% if (user.role === 'admin') { %>
                    Admin account
                  <% } else { %>
                    <form action="/admin/users/<%= user._id %>/toggle-status" method="post" style="display:inline;">
                      <button type="submit" class="link" style="background:none;border:none;padding:0;cursor:pointer; font: inherit;">
                        <%= user.isBlocked ? 'Unblock' : 'Block' %>
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </section>
    </main>
  </body>
</html>
